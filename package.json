{
  "name": "release-assistant",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "node server/team-http.mjs",
    "setup": "node scripts/setup.mjs",
    "ops": "node scripts/ops.mjs",
    "mcp": "node server/mcp.mjs",
    "agent:eval": "node scripts/eval-agent.mjs",
    "model:check": "node scripts/check-model.mjs",
    "test": "node --test demo/versions.test.mjs tests/v1.test.mjs tests/team.test.mjs tests/ranges.test.mjs tests/materials.test.mjs tests/day-comparison.test.mjs tests/tracking.test.mjs tests/notifications.test.mjs tests/release-decision.test.mjs tests/source-policy.test.mjs",
    "test:ui": "pnpm build && node --test tests/workspace.browser.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "csv-parse": "^6.1.0",
    "google-auth-library": "^10.9.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.12",
    "playwright": "1.65.1",
    "typescript": "~5.9.3"
  }
}
