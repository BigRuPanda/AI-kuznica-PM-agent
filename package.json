{
  "name": "release-assistant",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "node server/team-http.mjs",
    "setup": "node scripts/setup.mjs",
    "ops": "node scripts/ops.mjs",
    "mcp": "node server/mcp.mjs",
    "agent:eval": "node scripts/eval-agent.mjs",
    "model:check": "node scripts/check-model.mjs",
    "model:key": "node scripts/set-anymodel-key.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "pilot:prepare": "node pilot/prepare.mjs",
    "pilot:start": "node pilot/start.mjs",
    "pilot:recovery": "node pilot/recovery.mjs",
    "pilot:accept": "node scripts/pilot-acceptance.mjs",
    "test:ui": "pnpm build && node --test \"tests/*.browser.mjs\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "csv-parse": "^6.1.0",
    "google-auth-library": "^10.9.1",
    "playwright-core": "1.65.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.12",
    "playwright": "1.65.1",
    "typescript": "~5.9.3"
  }
}
