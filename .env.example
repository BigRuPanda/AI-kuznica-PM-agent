# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Несколько ID указываются через запятую
TELEGRAM_CHAT_IDS=

# API языковой модели
LLM_BACKEND=gemini
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gemini-3.5-flash
# analysis — многошаговые расследования с фактами. selection — локальный расчёт без передачи отчёта.
LLM_DATA_MODE=analysis
# Для LLM_BACKEND=vertex укажите проект Google Cloud. Регион global поддерживает Gemini 3.5 Flash-Lite.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# При использовании локальных ADC это поле можно оставить пустым.
GOOGLE_APPLICATION_CREDENTIALS=

# Приложение и база данных
APP_BASE_URL=
DATABASE_URL=

# Команда и регистрация. pnpm setup создаёт случайные приглашения.
ADMIN_INVITE_KEY=
DEMO_INVITE_KEY=
PORT=8090
BIND_HOST=127.0.0.1
SITE_DOMAIN=
PYTHON_BIN=
MCP_ACCESS_TOKEN=
# Уведомления включаются после проверки получателей.
NOTIFICATIONS_ENABLED=false
# Командный логин получателя автоматических сигналов. Нужен подтверждённый контакт в настройках.
SIGNAL_OWNER_LOGIN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
# Локальный стенд с одним получателем обновлений бота. Для HTTPS webhook оставьте false.
TELEGRAM_BIND_POLLING=false
# Включает создание подтверждённых задач через Redmine и импорт результатов закрытия.
SIGNAL_BRIDGE_URL=
# Требовать подтверждённый флаг задач в проекте Redmine на защищённом демостенде.
REDMINE_REQUIRE_AI_FLAG=false
# HTTP-адрес локального Redmine для проверки прямого подключения к проекту signal-demo.
REDMINE_DEMO_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
# Яндекс Метрика: перечень ID через запятую. JSON-массив описан в README.
METRIKA_COUNTER_IDS=
METRIKA_TOKEN=
METRIKA_REPORTS_JSON=
METRIKA_SYNC_MINUTES=0
# Персональные подключения. Ключ шифрования создаёт pnpm setup.
INTEGRATION_KEY=
CONFLUENCE_CLIENT_ID=
CONFLUENCE_CLIENT_SECRET=
# Тариф за миллион токенов и стоимость инфраструктуры за месяц в одной валюте.
PRICE_INPUT_MILLION=
PRICE_OUTPUT_MILLION=
MONTHLY_INFRA_COST=
MONTHLY_REQUESTS=

# Для отдельной базы с исходным ZIP и согласованными версиями материалов.
SOURCE_ARCHIVE_SHA256=
