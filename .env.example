# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Несколько ID указываются через запятую
TELEGRAM_CHAT_IDS=

# API языковой модели
# local обрабатывает данные на сервере и проверяет адрес каждой интеграции.
# У существующих установок без DATA_PROFILE действует configured.
DATA_PROFILE=local
LOCAL_HTTP_ORIGINS=
LOCAL_SMTP_TARGET=
LLM_BACKEND=proxyapi
LLM_MODEL=qwen/qwen3.7-flash
PROXYAPI_API_KEY=
# Ключ и адрес для других провайдеров. ProxyAPI использует https://api.proxyapi.ru/v1.
LLM_API_KEY=
LLM_BASE_URL=
# analysis — многошаговые расследования с фактами. selection — локальный расчёт без передачи отчёта.
LLM_DATA_MODE=analysis
# Для LLM_BACKEND=vertex укажите проект Google Cloud. Регион global поддерживает Gemini 3.5 Flash-Lite.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# При использовании локальных ADC это поле можно оставить пустым.
GOOGLE_APPLICATION_CREDENTIALS=

# Приложение и база данных
APP_BASE_URL=
DATABASE_URL=

# Команда и регистрация. pnpm setup создаёт случайные приглашения.
ADMIN_INVITE_KEY=
DEMO_INVITE_KEY=
PORT=8090
BIND_HOST=127.0.0.1
SITE_DOMAIN=
PYTHON_BIN=
MCP_ACCESS_TOKEN=
# Уведомления включаются после проверки получателей.
NOTIFICATIONS_ENABLED=false
NOTIFICATION_CHANNELS=telegram,smtp
TELEGRAM_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
# Яндекс Метрика: перечень ID через запятую. JSON-массив описан в README.
METRIKA_COUNTER_IDS=
METRIKA_TOKEN=
METRIKA_REPORTS_JSON=
METRIKA_SYNC_MINUTES=0
METRIKA_TIME_ZONE=Europe/Moscow
# Персональные подключения. Ключ шифрования создаёт pnpm setup.
INTEGRATION_KEY=
CONFLUENCE_CLIENT_ID=
CONFLUENCE_CLIENT_SECRET=
# Тариф за миллион токенов и стоимость инфраструктуры за месяц в одной валюте.
PRICE_INPUT_MILLION=
PRICE_OUTPUT_MILLION=
MONTHLY_INFRA_COST=
MONTHLY_REQUESTS=

# Публичный поиск в профиле configured. Цена одного поискового запроса для ops cost.
YANDEX_SEARCH_FOLDER_ID=
YANDEX_SEARCH_API_KEY=
PRICE_WEB_REQUEST=
# SHA-256 оригинального ZIP для пространств с согласованием версий.
SOURCE_ARCHIVE_SHA256=
